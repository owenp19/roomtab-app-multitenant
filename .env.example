PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=minibar_app
DB_PASSWORD=your_secure_password_here
DB_NAME=minibar_app

# Admin credentials for seed (generated if not set)
# ADMIN_DEFAULT_PASSWORD=your_admin_password
# SUPER_ADMIN_DEFAULT_PASSWORD=your_super_admin_password

# Public URL (required in production for CORS and payment redirects)
# APP_URL=https://your-domain.com

# Payment gateways (at least one required for online payments)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_MODE=test

# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# MERCADOPAGO_WEBHOOK_SECRET=...
# MERCADOPAGO_MODE=test

# WOMPI_PUBLIC_KEY=pub_test_...
# WOMPI_PRIVATE_KEY=prv_test_...
# WOMPI_ENV=sandbox  # sandbox or production

# Public URL (used for payment redirects and webhooks)
# APP_URL=http://localhost:3000

<%
  var activeNav = typeof activeNav !== 'undefined' ? activeNav : '';
  function isActive(nav) { return activeNav === nav ? ' nav-item-active' : ''; }
  function isActiveAria(nav) { return activeNav === nav ? ' aria-current="page"' : ''; }
%>
<aside class="sidebar" aria-label="Navegaci&oacute;n principal">
  <div class="sidebar-top">
    <div class="sidebar-logo-block">
      <img loading="lazy" src="/images/roomtab-logo-dark-transparent.png" alt="RoomTab" class="sidebar-logo" />
    </div>


    <nav class="sidebar-nav">
      <a href="/app/panel-de-control" class="nav-item<%= isActive('dashboard') %>"<%= isActiveAria('dashboard') %>>
        <i class="ph-light ph-chart-pie nav-icon"></i>
        <span class="nav-label" data-i18n="navDashboard">Panel de Control</span>
      </a>
      <a href="/app/minibar" class="nav-item<%= isActive('minibar') %>"<%= isActiveAria('minibar') %>>
        <i class="ph-light ph-wine nav-icon"></i>
        <span class="nav-label" data-i18n="navMinibars">Minibares</span>
      </a>
      <a href="/app/revision-rapida" class="nav-item<%= isActive('revision') %>"<%= isActiveAria('revision') %>>
        <i class="ph-light ph-lightning nav-icon"></i>
        <span class="nav-label" data-i18n="navQuickReview">Revisi&oacute;n r&aacute;pida</span>
      </a>
      <a href="/app/admin" class="nav-item<%= isActive('admin') %>"<%= isActiveAria('admin') %>>
        <i class="ph-light ph-shield-check nav-icon"></i>
        <span class="nav-label" data-i18n="navAdmin">Admin</span>
      </a>
      <a href="/unlock.html" class="nav-item<%= isActive('unlock') %>"<%= isActiveAria('unlock') %>>
        <i class="ph-light ph-key nav-icon"></i>
        <span class="nav-label" data-i18n="navUnlock">Desbloqueo</span>
      </a>
      <a href="/app/perdidas" class="nav-item<%= isActive('perdidas') %>"<%= isActiveAria('perdidas') %>>
        <i class="ph-light ph-chart-bar nav-icon"></i>
        <span class="nav-label" data-i18n="navPerdidas">P&eacute;rdidas</span>
      </a>
      <a href="/app/reportes" class="nav-item<%= isActive('reportes') %>"<%= isActiveAria('reportes') %>>
        <i class="ph-light ph-file-text nav-icon"></i>
        <span class="nav-label" data-i18n="navReportes">Reportes</span>
      </a>
      <a href="/app/auditoria" class="nav-item<%= isActive('auditoria') %>"<%= isActiveAria('auditoria') %>>
        <i class="ph-light ph-clipboard-text nav-icon"></i>
        <span class="nav-label" data-i18n="navAudit">Auditor&iacute;a</span>
      </a>
      <a href="/app/calendario" class="nav-item<%= isActive('calendario') %>"<%= isActiveAria('calendario') %>>
        <i class="ph-light ph-calendar-blank nav-icon"></i>
        <span class="nav-label" data-i18n="navCalendar">Calendario</span>
      </a>
      <a href="/app/notificaciones" class="nav-item<%= isActive('notificaciones') %>"<%= isActiveAria('notificaciones') %> id="nav-notifications">
        <i class="ph-light ph-bell nav-icon"></i>
        <span class="nav-label" data-i18n="navNotifications">Notificaciones</span>
        <span class="nav-badge" id="notif-badge" style="display:none;"></span>
        <span class="nav-alert-dot" id="smart-alert-dot" style="display:none;" title="Alertas críticas"></span>
      </a>

    </nav>

    <div class="sidebar-credit">
      <span data-i18n="footerVersion">v1.0.1</span><br>
      <span data-i18n="footerDeveloped">Desarrollado por Owen Pusey Minibar Management System</span>
    </div>
  </div>


<style>
.nav-alert-dot { display: inline-block; width: 8px; height: 8px; background: #ef4444; border-radius: 50%; margin-left: 4px; vertical-align: middle; animation: pulse-dot 2s infinite; position: relative; top: -1px; }
@keyframes pulse-dot { 0% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.3); } 100% { opacity: 1; transform: scale(1); } }
</style>
<script>
(async function(){try{var r=await fetch("/api/dashboard/smart-alerts");if(!r.ok)return;var d=await r.json();if(d.summary&&d.summary.critical_count>0){var dot=document.getElementById("smart-alert-dot");if(dot)dot.style.display="inline-block"}}catch(e){}})();
</script>
</aside>

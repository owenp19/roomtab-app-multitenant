<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <%- include('../partials/head-auth', { title: 'RoomTab — Recuperar contraseña' }) %>
</head>
<body>
  <div class="login-page">
    <section class="login-panel">
      <div class="login-top-bar">
        <div class="theme-toggle-group" id="forgot-theme-switcher">
          <button class="theme-toggle-btn active" data-theme-mode="light" aria-label="Cambiar a modo claro" title="Cambiar a modo claro"><i class="ph-light ph-sun"></i></button>
          <button class="theme-toggle-btn" data-theme-mode="dark" aria-label="Cambiar a modo oscuro" title="Cambiar a modo oscuro"><i class="ph-light ph-moon"></i></button>
        </div>
        <div class="header-lang-group" id="forgot-lang-selector">
          <button class="header-lang-btn" data-lang="es">ES</button>
          <button class="header-lang-btn" data-lang="en">EN</button>
        </div>
      </div>

      <div class="login-brand">
        <img src="/images/roomtab-logo-light.png" alt="RoomTab" class="login-brand-logo" loading="lazy" />
        <div class="login-brand-silhouette"></div>
        <div class="login-brand-text"><span class="login-brand-name" data-i18n="forgotBrandText">Sistema de gestión de minibar</span></div>
      </div>

      <header class="login-header">
        <h1 data-i18n="forgotTitle">&iquest;Olvidaste tu contrase&ntilde;a?</h1>
        <p data-i18n="forgotSubtitle">Ingresa tu correo y te enviaremos un enlace para restablecerla.</p>
      </header>

      <form id="forgot-form" class="login-form">
        <div class="field">
          <label for="email" data-i18n="forgotEmail">Correo electr&oacute;nico</label>
          <div class="field-input-wrapper">
            <span class="field-icon"><i class="ph-light ph-envelope"></i></span>
            <input type="email" id="email" name="email" placeholder="operador@nattivo.com" data-i18n-placeholder="forgotEmailPlaceholder" autocomplete="email" required />
          </div>
        </div>
        <button type="submit" class="btn-primary" id="forgot-submit" data-i18n="forgotSubmit">Enviar enlace</button>
        <div id="forgot-status" class="login-status"></div>
      </form>

      <div class="login-footer">
        <span data-i18n="forgotRemembered">&iquest;Recordaste tu contrase&ntilde;a?</span>
        <a href="/login.html" class="link-button" data-i18n="forgotLogin">Inicia sesi&oacute;n</a>
      </div>
    </section>

    <section class="login-photo">
      <div class="photo-overlay"></div>
      <div class="photo-decoration"><div class="photo-wave"></div></div>
      <div class="photo-caption">
        <div class="photo-caption-silhouette"></div>
        <h2 data-i18n="forgotBrandText">Sistema de gestión de minibar</h2>
        <p data-i18n="forgotPhotoSubtitle">Ingresa con tu correo corporativo y contrase&ntilde;a.</p>
      </div>
    </section>
  </div>
  <%- include('../partials/scripts-auth') %>
  <script src="/js/forgot-password.js" defer></script>
</body>
</html>

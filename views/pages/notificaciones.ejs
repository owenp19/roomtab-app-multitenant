<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <%- include('../partials/head', { title: 'Notificaciones – RoomTab' }) %>
</head>
<body>
  <%- include('../partials/loader') %>
  <div class="app-shell">
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
    <%- include('../partials/sidebar', { activeNav: 'notificaciones' }) %>
    <main class="main-panel">
      <header class="main-header">
        <button class="menu-toggle" id="menu-toggle" aria-label="Abrir men&uacute;">
          <i class="ph-light ph-list"></i>
        </button>
        <div class="main-header-title">
          <div id="breadcrumb">
            <span class="crumb">
              <i class="ph-light ph-bell"></i>
              <span class="crumb-current" data-i18n="notifTitle">Notificaciones</span>
            </span>
          </div>
          <h1 data-i18n="notifExpiryTitle">
            <i class="ph-light ph-bell"></i>
            Notificaciones de vencimiento
          </h1>
          <p id="page-description" data-i18n="notifDesc">Productos pr&oacute;ximos a vencer en los minibares.</p>
        </div>
        <div class="header-controls">
          <div class="theme-toggle-group" id="app-theme-switcher">
            <button class="theme-toggle-btn active" data-theme-mode="light" aria-label="Modo claro" title="Modo claro">
              <i class="ph-light ph-sun"></i>
            </button>
            <button class="theme-toggle-btn" data-theme-mode="dark" aria-label="Modo oscuro" title="Modo oscuro">
              <i class="ph-light ph-moon"></i>
            </button>
          </div>
          <div class="header-lang-group" id="app-lang-selector">
            <button class="header-lang-btn active" data-lang="es">ES</button>
            <button class="header-lang-btn" data-lang="en">EN</button>
          </div>
          <div class="header-user-profile" id="header-user-profile">
            <div class="header-user-avatar">
              <span id="header-user-initials"></span>
              <img loading="lazy" id="header-user-img" class="header-avatar-img" src="" alt="" style="display:none" />
            </div>
            <div class="header-user-info">
              <div class="header-user-name" id="header-user-name">Operador</div>
              <div class="header-user-role" id="header-user-role">Minibar Operator</div>
              <div class="header-user-tenant" id="header-user-tenant">Sistema de gestión de minibar</div>
            </div>
            <i class="ph-light ph-caret-down header-profile-chevron"></i>
            <div class="header-profile-dropdown" id="header-profile-dropdown">
              <a href="/perfil" class="dropdown-item"><i class="ph-light ph-user"></i> <span data-i18n="navProfile">Perfil</span></a>
              <a href="/settings" class="dropdown-item"><i class="ph-light ph-gear"></i> <span data-i18n="navSettings">Configuraci&oacute;n</span></a>
              <div class="dropdown-divider"></div>
              <form action="/api/auth/logout" method="POST">
                <button type="submit" class="dropdown-item dropdown-item-danger"><i class="ph-light ph-sign-out"></i> <span data-i18n="navLogout">Cerrar sesi&oacute;n</span></button>
              </form>
            </div>
          </div>
        </div>
      </header>

      <div class="main-content">
        <div class="notif-filters">
          <div class="notif-filter-row">
            <div class="admin-form-group" style="flex:1;min-width:150px;">
              <label data-i18n="notifFilterFloor">Filtrar por piso</label>
              <select class="admin-input" id="filter-floor"><option value="">Todos los pisos</option></select>
            </div>
            <div class="admin-form-group" style="flex:1;min-width:150px;">
              <label data-i18n="notifFilterRoom">Filtrar por habitaci&oacute;n</label>
              <div class="notif-rooms-grid" id="filter-room-grid">
                <div class="notif-room-chip active" data-room-id="">Todas</div>
              </div>
            </div>
            <div class="admin-form-group" style="flex:1;min-width:150px;">
              <label data-i18n="notifFilterProduct">Filtrar por producto</label>
              <input class="admin-input" id="filter-product" type="text" data-i18n-placeholder="notifSearchProduct" placeholder="Buscar producto..." />
            </div>
            <div class="admin-form-group" style="display:flex;align-items:flex-end;">
              <button class="btn-primary btn-sm" id="btn-check-now" title="Revisar vencimientos ahora" style="margin-right:8px;">
                <i class="ph-light ph-magnifying-glass"></i> Revisar ahora
              </button>
              <button class="btn-primary btn-sm" id="btn-mark-all-read" title="Marcar todo como le&iacute;do" data-i18n="notifMarkAllRead">
                <i class="ph-light ph-check-double"></i> Marcar todo le&iacute;do
              </button>
            </div>
          </div>
        </div>
        <div id="notifications-container">
          <div class="empty-state" id="notif-empty">
            <i class="ph-light ph-bell"></i>
            <h3 data-i18n="notifLoading">Cargando...</h3>
            <p data-i18n="notifFetching">Obteniendo notificaciones.</p>
          </div>
        </div>
      </div>
    </main>
  </div>
  <%- include('../partials/scripts') %>
  <script src="/js/notificaciones.js" defer></script>
</body>
</html>

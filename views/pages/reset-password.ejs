<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <%- include('../partials/head-auth', { title: 'RoomTab — Restablecer contraseña' }) %>
</head>
<body>
  <div class="login-page">
    <section class="login-panel">
      <div class="login-top-bar">
        <div class="theme-toggle-group" id="reset-theme-switcher">
          <button class="theme-toggle-btn active" data-theme-mode="light" aria-label="Cambiar a modo claro" title="Cambiar a modo claro"><i class="ph-light ph-sun"></i></button>
          <button class="theme-toggle-btn" data-theme-mode="dark" aria-label="Cambiar a modo oscuro" title="Cambiar a modo oscuro"><i class="ph-light ph-moon"></i></button>
        </div>
        <div class="header-lang-group" id="reset-lang-selector">
          <button class="header-lang-btn" data-lang="es">ES</button>
          <button class="header-lang-btn" data-lang="en">EN</button>
        </div>
      </div>

      <div class="login-brand">
        <img src="/images/roomtab-logo-light.png" alt="RoomTab" class="login-brand-logo" loading="lazy" />
        <div class="login-brand-silhouette"></div>
        <div class="login-brand-text"><span class="login-brand-name" data-i18n="resetBrandText">Minibar management system</span></div>
      </div>

      <header class="login-header">
        <h1 data-i18n="resetTitle">Restablecer contrase&ntilde;a</h1>
        <p data-i18n="resetSubtitle">Ingresa tu nueva contrase&ntilde;a.</p>
      </header>

      <form id="reset-form" class="login-form">
        <div class="field">
          <label for="password" data-i18n="resetNewPassword">Nueva contrase&ntilde;a</label>
          <div class="field-input-wrapper">
            <span class="field-icon"><i class="ph-light ph-lock"></i></span>
            <input type="password" id="password" name="password" placeholder="M&iacute;n. 6 caracteres" data-i18n-placeholder="resetNewPasswordPlaceholder" autocomplete="new-password" required />
            <button type="button" class="field-toggle" id="password-toggle"><i class="ph-light ph-eye-slash"></i></button>
          </div>
        </div>
        <div class="field">
          <label for="confirm-password" data-i18n="resetConfirmPassword">Confirmar contrase&ntilde;a</label>
          <div class="field-input-wrapper">
            <span class="field-icon"><i class="ph-light ph-lock"></i></span>
            <input type="password" id="confirm-password" name="confirm-password" placeholder="Repite la contrase&ntilde;a" data-i18n-placeholder="resetConfirmPasswordPlaceholder" autocomplete="new-password" required />
          </div>
        </div>
        <button type="submit" class="btn-primary" id="reset-submit" data-i18n="resetSubmit">Restablecer</button>
        <div id="reset-status" class="login-status"></div>
      </form>

      <div class="login-footer">
        <span data-i18n="resetRemembered">&iquest;Recordaste tu contrase&ntilde;a?</span>
        <a href="/login.html" class="link-button" data-i18n="resetLogin">Inicia sesi&oacute;n</a>
      </div>
    </section>

    <section class="login-photo">
      <div class="photo-overlay"></div>
      <div class="photo-decoration"><div class="photo-wave"></div></div>
      <div class="photo-caption">
        <div class="photo-caption-silhouette"></div>
        <h2 data-i18n="resetBrandText">Minibar management system</h2>
        <p data-i18n="resetPhotoSubtitle">Ingresa con tu correo corporativo y contrase&ntilde;a.</p>
      </div>
    </section>
  </div>
  <%- include('../partials/scripts-auth') %>
  <script src="/js/reset-password.js" defer></script>
</body>
</html>
